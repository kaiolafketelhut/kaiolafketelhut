10 REM TRON.BAS - light cycles, in the style of DONKEY.BAS (GW-BASIC/BASICA)
20 REM Steer with W A S D. Q quits. You are O (green), the computer is X (red).
30 SCREEN 0 : WIDTH 80 : KEY OFF : CLS : RANDOMIZE TIMER
40 DIM G%(80,24)
50 LOCATE 10,34 : PRINT "T R O N"
60 LOCATE 12,22 : PRINT "W A S D to steer - press any key"
70 IF INKEY$="" THEN 70
80 CLS
90 FOR X=1 TO 80 : G%(X,2)=9 : G%(X,24)=9 : LOCATE 2,X : PRINT "#"; : LOCATE 24,X : PRINT "#"; : NEXT X
100 FOR Y=2 TO 24 : G%(1,Y)=9 : G%(80,Y)=9 : LOCATE Y,1 : PRINT "#"; : LOCATE Y,80 : PRINT "#"; : NEXT Y
110 PX=20 : PY=13 : PDX=1 : PDY=0
120 CX=60 : CY=13 : CDX=-1 : CDY=0
130 G%(PX,PY)=1 : G%(CX,CY)=2
140 REM --- main loop ---
150 A$=INKEY$
160 IF A$="" THEN 220
170 IF A$="w" OR A$="W" THEN IF PDY=0 THEN PDX=0 : PDY=-1
180 IF A$="s" OR A$="S" THEN IF PDY=0 THEN PDX=0 : PDY=1
190 IF A$="a" OR A$="A" THEN IF PDX=0 THEN PDX=-1 : PDY=0
200 IF A$="d" OR A$="D" THEN IF PDX=0 THEN PDX=1 : PDY=0
210 IF A$="q" OR A$="Q" THEN CLS : END
220 REM computer: turn when blocked ahead, or now and then at random
230 IF G%(CX+CDX,CY+CDY)<>0 OR RND<.05 THEN GOSUB 400
240 PX=PX+PDX : PY=PY+PDY : CX=CX+CDX : CY=CY+CDY
250 L1=0 : L2=0
260 IF G%(PX,PY)<>0 THEN L1=1
270 IF G%(CX,CY)<>0 THEN L2=1
280 IF PX=CX AND PY=CY THEN L1=1 : L2=1
290 IF L1 OR L2 THEN 500
300 G%(PX,PY)=1 : G%(CX,CY)=2
310 COLOR 10 : LOCATE PY,PX : PRINT "O"; : COLOR 12 : LOCATE CY,CX : PRINT "X"; : COLOR 7
320 T0=TIMER : WHILE TIMER-T0<.08 : WEND
330 GOTO 150
400 REM pick a free turn for the computer
410 T=1 : IF RND<.5 THEN T=-1
420 FOR K=1 TO 2
430 IF CDX<>0 THEN TX=0 : TY=T ELSE TX=T : TY=0
440 IF G%(CX+TX,CY+TY)=0 THEN CDX=TX : CDY=TY : RETURN
450 T=-T
460 NEXT K
470 RETURN
500 REM game over
510 LOCATE 12,30 : COLOR 14
520 IF L1 AND L2 THEN PRINT " DRAW " ELSE IF L1 THEN PRINT " YOU CRASHED " ELSE PRINT " YOU WIN "
530 COLOR 7 : LOCATE 14,28 : PRINT "PRESS ANY KEY"
540 IF INKEY$="" THEN 540
550 CLS : END
