<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.oeneye.inertia+json">
    <comment>oeneye Inertia Binary Bypass payload</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.inertia"/>
  </mime-type>
  <mime-type type="image/vnd.oeneye.ximg">
    <comment>oeneye XIMG image</comment>
    <magic priority="60">
      <match type="string" value="XIMG" offset="0"/>
    </magic>
    <glob pattern="*.ximg"/>
  </mime-type>
  <mime-type type="text/vnd.oeneye.qxd">
    <comment>QxD node source</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.iQxD"/>
  </mime-type>
</mime-info>
